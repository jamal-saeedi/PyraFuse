# Models & artifacts — keep folder structure, ignore actual files
models/checkpoints/*
models/finals/*
artifacts/logs/*
artifacts/*.log
artifacts/*.status
artifacts/mplconfig/
!models/**/.gitkeep
!artifacts/**/.gitkeep


