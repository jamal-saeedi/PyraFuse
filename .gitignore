# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/          # no local venv — use shared ~/.venvs/ml

# uv
# uv.lock is intentionally committed — do not add it here
# requirements.lock is intentionally committed — do not add it here

