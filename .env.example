# Copy to .env and fill in values. Never commit .env.

# Hugging Face model repository used by `pyrafuse.load_pretrained` when a
# checkpoint is not available under models/finals/ locally.
# PYRAFUSE_MODEL_REPO=<namespace>/PyraFuse

# Required only for gated/private Hugging Face repositories or backbones.
# HF_TOKEN=hf_...
