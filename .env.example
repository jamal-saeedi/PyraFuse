# Copy to .env and fill in values. Never commit .env.

# Optional Hugging Face model mirror/fork. By default `pyrafuse.load_pretrained`
# uses the official public release: jamal-one/PyraFuse.
# PYRAFUSE_MODEL_REPO=your-namespace/PyraFuse

# Required only for gated/private Hugging Face repositories or backbones.
# HF_TOKEN=hf_...
